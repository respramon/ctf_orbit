include README.md LICENSE NOTICE.md CONTRIBUTING.md SECURITY.md
include Dockerfile Makefile requirements.txt .gitignore .dockerignore
include CHECKSUMS.sha256
recursive-include docs *.md
recursive-include scripts *.py *.sh *.ps1
recursive-include examples *
recursive-include templates *.py *.md
recursive-include tests *.py
recursive-include wordlists *.txt *.md
graft .github
global-exclude __pycache__ *.py[cod]

